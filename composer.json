{
  "name": "jcodigital/jcore-silta",
  "description": "Syncs posts, custom fields, terms and media between WordPress sites, with search-replace and a diff mode for choosing what to sync.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "J&Co Digital Oy",
      "email": "support@jco.fi"
    }
  ],
  "require": {
    "php": ">=8.2",
    "jcodigital/jcore-update": "^1.7"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "paragonie/sodium_compat": "^2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^11",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit"
  }
}
