# Copy to dev/.env (git ignores it) to install commercial plugins in the dev
# stack and run the integration tests against them. Without a key, both sites
# run without Gravity Forms (its tests are skipped) and with Secure Custom
# Fields instead of ACF Pro.
#
# Paid WooCommerce extensions (WooCommerce Product Bundles) need no key here:
# put their zips in dev/woocommerce/extensions/.

# A Gravity Forms Elite (or legacy Developer) license key: Composer installs
# from composer.gravity.io only for those. It is the HTTP basic auth user name.
GRAVITY_FORMS_LICENSE_KEY=

# The HTTP basic auth password Gravity Forms' Composer repository asks for: a
# site URL. Defaults to http://localhost:8090.
GRAVITY_FORMS_SITE_URL=

# An ACF Pro license key: Composer installs from connect.advancedcustomfields.com
# with it as the HTTP basic auth user name. Compose also passes it to both
# sites, where it defines ACF_PRO_LICENSE.
ACF_PRO_LICENSE_KEY=

# The HTTP basic auth password ACF's Composer repository asks for: a site URL
# the license is active for, with http:// or https://. Defaults to
# http://localhost:8090.
ACF_PRO_SITE_URL=
