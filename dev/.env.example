# Copy to dev/.env (git ignores it) to install Gravity Forms in the dev stack
# and run the Gravity Forms integration tests. Without a key, both sites run
# without Gravity Forms and those tests are skipped.

# A Gravity Forms Elite (or legacy Developer) license key: Composer installs
# from composer.gravity.io only for those. It is the HTTP basic auth user name.
GRAVITY_FORMS_LICENSE_KEY=

# The HTTP basic auth password Gravity Forms' Composer repository asks for: a
# site URL. Defaults to http://localhost:8090.
GRAVITY_FORMS_SITE_URL=
