# Local secrets: dev/.env holds the license keys for the commercial plugins
# in the dev stack, auth.json Composer credentials. Never commit them.
.env
auth.json
# Commercial plugins for the dev stack: Gravity Forms and ACF Pro, installed
# by dev/<name>/install.sh, and the WooCommerce extension zips dropped into
# dev/woocommerce/extensions/. The repository is public: never commit them.
/dev/gravityforms/composer.lock
/dev/gravityforms/plugins/
/dev/gravityforms/vendor/
/dev/acf-pro/composer.lock
/dev/acf-pro/plugins/
/dev/acf-pro/vendor/
/dev/woocommerce/extensions/*
!/dev/woocommerce/extensions/README.md
