{
  "name": "jcore-silta",
  "version": "0.2.0",
  "description": "Syncs posts, custom fields, terms and media between WordPress sites, with search-replace and a diff mode for choosing what to sync.",
  "author": "J&Co Digital Oy <support@jco.fi>",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "format": "wp-scripts format src",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style 'src/**/*.scss' --allow-empty-input",
    "lint:php": "composer lint",
    "check": "pnpm lint:js && pnpm lint:css && pnpm lint:php",
    "i18n": "pnpm make-pot && pnpm make-mo && pnpm make-json",
    "make-pot": "wp i18n make-pot . languages/jcore-silta.pot --domain=jcore-silta --slug=jcore-silta --exclude=vendor,node_modules,src,release,.wp,dev,tests,docs",
    "make-mo": "wp i18n make-mo languages languages",
    "make-json": "pnpm --package=@wp-blocks/make-pot@1.6.3 dlx makejson build/ languages/",
    "playground": "wp-playground-cli server --blueprint=.wp/blueprint.json --mount=.:/wordpress/wp-content/plugins/jcore-silta --php=8.2 --port=8887"
  },
  "devDependencies": {
    "@wordpress/api-fetch": "^7.57.0",
    "@wordpress/components": "^42.0.0",
    "@wordpress/data": "^10.57.0",
    "@wordpress/date": "^5.57.0",
    "@wordpress/editor": "^15.2.0",
    "@wordpress/element": "^9.0.0",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/plugins": "^7.57.0",
    "@wordpress/scripts": "^36.1.0",
    "@wordpress/url": "^4.57.0",
    "@wp-playground/cli": "^3.1.54",
    "typescript": "~6.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCO-Digital/jcore-silta.git"
  },
  "bugs": {
    "url": "https://github.com/JCO-Digital/jcore-silta/issues"
  },
  "homepage": "https://github.com/JCO-Digital/jcore-silta#readme"
}
