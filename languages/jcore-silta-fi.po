msgid "JCORE Silta"
msgstr "JCORE Silta"

#. Plugin URI of the plugin
#: jcore-silta.php
msgid "https://github.com/JCO-Digital/jcore-silta"
msgstr "https://github.com/JCO-Digital/jcore-silta"

#. Description of the plugin
#: jcore-silta.php
msgid "Syncs posts, custom fields, terms and media between WordPress sites, with search-replace and a diff mode for choosing what to sync."
msgstr "Synkronoi artikkelit, lisäkentät, termit ja median WordPress-sivustojen välillä. Mukana on hae ja korvaa -toiminto sekä erojen tarkastelu, jossa valitset, mitä synkronoidaan."

#. Author of the plugin
#: jcore-silta.php
msgid "J&Co Digital Oy"
msgstr "J&Co Digital Oy"

#. Author URI of the plugin
#: jcore-silta.php
msgid "https://jco.fi"
msgstr "https://jco.fi"

#: includes/admin/class-list-actions.php:92
#: includes/admin/class-list-actions.php:131
msgid "Push with Silta"
msgstr "Lähetä Sillan kautta"

#. translators: %s: connected site's label.
#: includes/admin/class-list-actions.php:115
#, php-format
msgid "Pull from %s"
msgstr "Hae sivustolta %s"

#. translators: %s: address of the site the database came from.
#: includes/admin/class-notices.php:52
#, php-format
msgid "JCORE Silta: this database was copied from %s, so Silta switched off the connections that came with it and gave this site a new identity."
msgstr "JCORE Silta: tämän sivuston tietokanta on kopio (lähde: %s), joten Silta poisti käytöstä sen mukana tulleet yhteydet ja antoi tälle sivustolle uuden identiteetin."

#: includes/admin/class-notices.php:53
msgid "another site"
msgstr "toinen sivusto"

#: includes/admin/class-notices.php:57
msgid "Review the connections"
msgstr "Tarkista yhteydet"

#: includes/class-plugin.php:155
#: build/admin.js:26
msgid "Open"
msgstr "Avaa"

#: includes/crypto/class-identity.php:89
msgid "JCORE_SILTA_PRIVATE_KEY in wp-config.php is not a valid key. Remove it or replace it with the value from \"wp silta key export\"."
msgstr "wp-config.php-tiedoston JCORE_SILTA_PRIVATE_KEY ei ole kelvollinen avain. Poista se tai korvaa se komennon ”wp silta key export” antamalla arvolla."

#: includes/crypto/class-identity.php:111
msgid "The key is defined in wp-config.php. Change it there."
msgstr "Avain on määritetty wp-config.php-tiedostossa. Muuta sitä siellä."

#: includes/crypto/class-identity.php:156
msgid "This site has no usable signing key. Add the connection again."
msgstr "Tällä sivustolla ei ole käyttökelpoista allekirjoitusavainta. Lisää yhteys uudelleen."

#: includes/endpoint/class-local.php:134
msgid "Not an attachment."
msgstr "Kohde ei ole liite."

#: includes/endpoint/class-local.php:160
msgid "The import has no job ID."
msgstr "Tuonnilla ei ole työn tunnistetta."

#: includes/endpoint/class-local.php:208
msgid "This site has no record of that sync."
msgstr "Tällä sivustolla ei ole tietoa kyseisestä synkronoinnista."

#: includes/endpoint/class-local.php:211
msgid "That sync came from another site."
msgstr "Kyseinen synkronointi tuli toiselta sivustolta."

#: includes/jobs/class-runner.php:104
#: includes/remote/class-connections.php:172
#: includes/remote/class-connections.php:229
#: includes/rest/class-source-controller.php:128
#: includes/rest/class-source-controller.php:148
msgid "No such connection."
msgstr "Yhteyttä ei löydy."

#: includes/jobs/class-runner.php:107
msgid "Choose push or pull."
msgstr "Valitse lähetys tai haku."

#: includes/jobs/class-runner.php:123
msgid "The other site does not allow this site to push to it."
msgstr "Toinen sivusto ei salli tämän sivuston lähettää sille sisältöä."

#: includes/jobs/class-runner.php:124
msgid "The other site does not allow this site to pull from it."
msgstr "Toinen sivusto ei salli tämän sivuston hakea siltä sisältöä."

#: includes/jobs/class-runner.php:135
msgid "Select something to sync."
msgstr "Valitse jotain synkronoitavaa."

#: includes/jobs/class-runner.php:176
#: includes/rest/class-jobs-controller.php:241
#: includes/rest/class-jobs-controller.php:263
#: includes/rest/class-jobs-controller.php:324
#: includes/rest/class-jobs-controller.php:367
#: includes/rest/class-jobs-controller.php:490
msgid "No such sync."
msgstr "Synkronointia ei löydy."

#: includes/jobs/class-runner.php:181
msgid "The connection this sync used has been removed."
msgstr "Tämän synkronoinnin käyttämä yhteys on poistettu."

#: includes/jobs/class-runner.php:285
#: includes/jobs/class-runner.php:313
#: includes/rest/class-jobs-controller.php:435
msgid "No such item."
msgstr "Kohdetta ei löydy."

#: includes/jobs/class-runner.php:334
msgid "The sync is not ready to run."
msgstr "Synkronointi ei ole valmis suoritettavaksi."

#: includes/jobs/class-runner.php:394
msgid "Only syncs that have written something can be undone."
msgstr "Vain synkronoinnit, jotka ovat kirjoittaneet jotain, voi kumota."

#: includes/jobs/class-runner.php:554
msgid "It no longer exists on the source site."
msgstr "Sitä ei enää ole lähdesivustolla."

#: includes/jobs/class-runner.php:937
msgid "The target did not report on this item."
msgstr "Kohdesivusto ei raportoinut tästä kohteesta."

#: includes/remote/class-client.php:57
msgid "This connection came with a copied database. Pair the sites again."
msgstr "Tämä yhteys tuli kopioidun tietokannan mukana. Yhdistä sivustot uudelleen."

#: includes/remote/class-client.php:60
msgid "This site's key has changed since the connection was made. Pair the sites again."
msgstr "Tämän sivuston avain on vaihtunut yhteyden luomisen jälkeen. Yhdistä sivustot uudelleen."

#. translators: %s: error message from the HTTP client.
#: includes/remote/class-client.php:157
#, php-format
msgid "The remote site could not be reached: %s"
msgstr "Etäsivustoon ei saatu yhteyttä: %s"

#. translators: %s: URL the remote redirected to.
#: includes/remote/class-client.php:171
#, php-format
msgid "The remote site redirected the request to %s. Pair the sites again using that address."
msgstr "Etäsivusto ohjasi pyynnön osoitteeseen %s. Yhdistä sivustot uudelleen käyttäen sitä osoitetta."

#. translators: %d: HTTP status code.
#: includes/remote/class-client.php:182
#, php-format
msgid "The remote site answered with something other than Silta data (HTTP %d). Check that the plugin is active there and that nothing blocks its REST API."
msgstr "Etäsivuston vastaus ei ollut Silta-dataa (HTTP %d). Tarkista, että lisäosa on siellä käytössä ja ettei mikään estä sen REST-rajapintaa."

#: includes/remote/class-client.php:191
msgid "The remote site returned an error."
msgstr "Etäsivusto palautti virheen."

#: includes/remote/class-connections.php:90
msgid "This pairing string was created on this site. Paste it on the other site."
msgstr "Tämä parituskoodi luotiin tällä sivustolla. Liitä se toiselle sivustolle."

#: includes/remote/class-connections.php:116
msgid "The remote site answered with a different identity than the pairing string promised."
msgstr "Etäsivusto vastasi eri identiteetillä kuin parituskoodi lupasi."

#. translators: 1: remote protocol version, 2: local protocol version.
#: includes/remote/class-connections.php:252
#, php-format
msgid "The remote runs an incompatible version of Silta (protocol %1$d, this site %2$d). Update the plugin on both sites."
msgstr "Etäsivustolla on yhteensopimaton Silta-versio (protokolla %1$d, tällä sivustolla %2$d). Päivitä lisäosa molemmille sivustoille."

#: includes/remote/class-connections.php:343
msgid "That is not a valid pairing string. Copy it again from the other site."
msgstr "Tämä ei ole kelvollinen parituskoodi. Kopioi se uudelleen toiselta sivustolta."

#: includes/remote/class-connections.php:361
msgid "The other site does not use HTTPS. Silta only connects to sites over HTTPS, except in local and development environments."
msgstr "Toinen sivusto ei käytä HTTPS:ää. Silta yhdistää sivustoihin vain HTTPS-yhteydellä, paitsi paikallisissa ympäristöissä ja kehitysympäristöissä."

#: includes/remote/class-trusted-keys.php:95
msgid "This pairing string is not valid or has already been used."
msgstr "Tämä parituskoodi ei ole kelvollinen tai se on jo käytetty."

#: includes/remote/class-trusted-keys.php:104
msgid "This pairing string has expired. Create a new one."
msgstr "Tämä parituskoodi on vanhentunut. Luo uusi."

#: includes/remote/class-trusted-keys.php:109
msgid "The public key is not valid."
msgstr "Julkinen avain ei ole kelvollinen."

#: includes/remote/class-trusted-keys.php:114
msgid "The site ID is not valid."
msgstr "Sivuston tunniste ei ole kelvollinen."

#: includes/remote/class-trusted-keys.php:220
msgid "No such site."
msgstr "Sivustoa ei löydy."

#: includes/remote/class-verifier.php:105
msgid "This site does not recognise the calling site. Pair the sites again."
msgstr "Tämä sivusto ei tunnista kutsuvaa sivustoa. Yhdistä sivustot uudelleen."

#: includes/remote/class-verifier.php:112
msgid "The request is too old, or the two servers' clocks disagree by more than five minutes."
msgstr "Pyyntö on liian vanha, tai palvelinten kellot eroavat toisistaan yli viisi minuuttia."

#: includes/remote/class-verifier.php:128
msgid "This request has already been received."
msgstr "Tämä pyyntö on jo vastaanotettu."

#: includes/remote/class-verifier.php:136
msgid "The remote site was copied from another site, so its connections are switched off. An admin there has to re-enable this site, or you pair again."
msgstr "Etäsivusto on kopioitu toiselta sivustolta, joten sen yhteydet on poistettu käytöstä. Sen ylläpitäjän on otettava tämä sivusto uudelleen käyttöön, tai sivustot on yhdistettävä uudelleen."

#: includes/remote/class-verifier.php:137
msgid "An admin on the remote site has switched off this connection."
msgstr "Etäsivuston ylläpitäjä on poistanut tämän yhteyden käytöstä."

#: includes/remote/class-verifier.php:146
msgid "The remote site does not allow this site to write to it."
msgstr "Etäsivusto ei salli tämän sivuston kirjoittaa siihen."

#: includes/remote/class-verifier.php:147
msgid "The remote site does not allow this site to read from it."
msgstr "Etäsivusto ei salli tämän sivuston lukea sen sisältöä."

#: includes/remote/class-verifier.php:154
msgid "The admin who allowed this connection on the remote site no longer has the rights to do so. Pair the sites again."
msgstr "Etäsivuston ylläpitäjällä, joka salli tämän yhteyden, ei ole enää siihen oikeuksia. Yhdistä sivustot uudelleen."

#: includes/remote/class-verifier.php:179
msgid "The pairing request could not be verified."
msgstr "Parituspyyntöä ei voitu varmentaa."

#: includes/rest/class-connections-controller.php:281
msgid "Allow reading, writing or both."
msgstr "Salli lukeminen, kirjoittaminen tai molemmat."

#: includes/rest/class-connections-controller.php:345
msgid "This site has no key yet. It gets one when it first connects to another site."
msgstr "Tällä sivustolla ei ole vielä avainta. Se saa avaimen, kun se yhdistää toiseen sivustoon ensimmäisen kerran."

#: includes/rest/class-jobs-controller.php:266
msgid "A sync that has written something stays in the history."
msgstr "Synkronointi, joka on kirjoittanut jotain, jää historiaan."

#: includes/rest/class-jobs-controller.php:327
msgid "This sync has already been undone."
msgstr "Tämä synkronointi on jo kumottu."

#: includes/rest/class-jobs-controller.php:493
msgid "This sync has already started; its selection can no longer change."
msgstr "Tämä synkronointi on jo alkanut, joten sen valintoja ei voi enää muuttaa."

#: includes/rest/class-remote-controller.php:118
msgid "The request was not verified."
msgstr "Pyyntöä ei varmennettu."

#: includes/rest/class-status-controller.php:60
msgid "This post cannot be synced."
msgstr "Tätä artikkelia ei voi synkronoida."

