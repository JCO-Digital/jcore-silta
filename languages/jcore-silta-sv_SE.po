msgid "JCORE Silta"
msgstr "JCORE Silta"

#. Plugin URI of the plugin
#: jcore-silta.php
msgid "https://github.com/JCO-Digital/jcore-silta"
msgstr "https://github.com/JCO-Digital/jcore-silta"

#. Description of the plugin
#: jcore-silta.php
msgid "Syncs posts, custom fields, terms and media between WordPress sites, with search-replace and a diff mode for choosing what to sync."
msgstr "Synkroniserar inlägg, anpassade fält, termer och media mellan WordPress-webbplatser, med sök och ersätt och ett läge för skillnader där du väljer vad som ska synkroniseras."

#. Author of the plugin
#: jcore-silta.php
msgid "J&Co Digital Oy"
msgstr "J&Co Digital Oy"

#. Author URI of the plugin
#: jcore-silta.php
msgid "https://jco.fi"
msgstr "https://jco.fi"

#: includes/admin/class-list-actions.php:92
#: includes/admin/class-list-actions.php:131
msgid "Push with Silta"
msgstr "Skicka med Silta"

#. translators: %s: connected site's label.
#: includes/admin/class-list-actions.php:115
#, php-format
msgid "Pull from %s"
msgstr "Hämta från %s"

#. translators: %s: address of the site the database came from.
#: includes/admin/class-notices.php:52
#, php-format
msgid "JCORE Silta: this database was copied from %s, so Silta switched off the connections that came with it and gave this site a new identity."
msgstr "JCORE Silta: den här databasen kopierades från %s, så Silta stängde av anslutningarna som följde med den och gav den här webbplatsen en ny identitet."

#: includes/admin/class-notices.php:53
msgid "another site"
msgstr "en annan webbplats"

#: includes/admin/class-notices.php:57
msgid "Review the connections"
msgstr "Granska anslutningarna"

#: includes/class-plugin.php:155
#: build/admin.js:26
msgid "Open"
msgstr "Öppna"

#: includes/crypto/class-identity.php:89
msgid "JCORE_SILTA_PRIVATE_KEY in wp-config.php is not a valid key. Remove it or replace it with the value from \"wp silta key export\"."
msgstr "JCORE_SILTA_PRIVATE_KEY i wp-config.php är inte en giltig nyckel. Ta bort den eller ersätt den med värdet från ”wp silta key export”."

#: includes/crypto/class-identity.php:111
msgid "The key is defined in wp-config.php. Change it there."
msgstr "Nyckeln är definierad i wp-config.php. Ändra den där."

#: includes/crypto/class-identity.php:156
msgid "This site has no usable signing key. Add the connection again."
msgstr "Den här webbplatsen har ingen användbar signeringsnyckel. Lägg till anslutningen igen."

#: includes/endpoint/class-local.php:134
msgid "Not an attachment."
msgstr "Inte en bilaga."

#: includes/endpoint/class-local.php:160
msgid "The import has no job ID."
msgstr "Importen saknar jobb-ID."

#: includes/endpoint/class-local.php:208
msgid "This site has no record of that sync."
msgstr "Den här webbplatsen har inga uppgifter om den synkroniseringen."

#: includes/endpoint/class-local.php:211
msgid "That sync came from another site."
msgstr "Den synkroniseringen kom från en annan webbplats."

